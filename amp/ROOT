chapter "AMP"

(*
 * Sessions for the verified asymmetric-multiprocessing (AMP) work.
 * See ../../PLAN.md for the current work stack; a session is added here as
 * work on it starts.
 *
 * Fast iteration (see amp/README.md): sit each session on top of an
 * already-built prerequisite whose heap is cached, so editing a session's
 * theory rebuilds only that theory, not its dependencies.
 *)

(*
 * UserData case, abstract-specification level: transports
 * call_kernel_integrity to a per-word confinement fact. See
 * AMP_UserData.thy's own comments for what this does and does not cover --
 * the design-spec and C-level transport are separate, still-open work.
 *)
session AMP_UserData in "userdata" = Access +
  theories
    "AMP_UserData"
    "AMP_UserData_Witnesses"

(*
 * Device-memory case, abstract-specification level: the integrity_device
 * analogue of AMP_UserData above. Sits on Access exactly as AMP_UserData
 * does. No refinement layers -- device_state models user-mapped MMIO only
 * and has no C-level representation to relate it to
 * (cuser_user_data_device_relation f ud \<equiv> True); see AMP_DeviceMem.thy's
 * own comments and PLAN.md's "Device memory: abstract-level confinement
 * via integrity_device" for why this case stops here.
 *)
session AMP_DeviceMem in "devicemem" = Access +
  theories
    "AMP_DeviceMem"
    "AMP_DeviceMem_Witnesses"

(*
 * UserData case, abstract-to-design-spec level: links user_mem (abstract)
 * to user_mem' (design spec) across a real call_kernel/callKernel step.
 * Built on Refine rather than on AMP_UserData/Access, since the cited
 * theorems (kernel_corres, user_mem_relation) live in proof/refine/, not
 * proof/access-control/. See AMP_UserData_Refine.thy's own comments for
 * what this does and does not cover -- the design-spec-to-C transport is
 * separate, still-open work. AMP_UserData is added via `sessions` because
 * the witness theory also witnesses kernel_entry_mem_unauthorized_unchanged
 * (an AMP_UserData theorem) -- see AMP_UserData_Refine_Witnesses.thy's own
 * comment for why that witness lives here rather than in AMP_UserData's own
 * session.
 *)
session AMP_UserData_Refine in "userdata_refine" = Refine +
  sessions
    AMP_UserData
  theories
    "AMP_UserData_Refine"
    "AMP_UserData_Refine_Witnesses"

(*
 * UserData case, design-spec-to-C level: links user_mem' (design spec) to
 * user_mem_C (C) across a real kernelEntry/kernelEntry_C step. Built on
 * CRefine, since the cited theorems (entry_refinement_C, user_mem_C_relation)
 * live in proof/crefine/. See AMP_UserData_Refine_C.thy's own comments for
 * what this does and does not cover -- assembling this with the
 * abstract-to-design-spec half into one real C-level UserData confinement
 * fact is separate, still-open work.
 *)
session AMP_UserData_Refine_C in "userdata_refine_c" = CRefine +
  theories
    "AMP_UserData_Refine_C"
    "AMP_UserData_Refine_C_Witnesses"

(*
 * UserData case, assembly: composes the abstract-specification,
 * abstract-to-design-spec, and design-spec-to-C halves above into one
 * theorem about a real C-level kernelEntry_C step. Built on
 * AMP_UserData_Refine_C (the richest ancestor, CRefine), with the other
 * two AMP UserData sessions added via `sessions` so their theorems are
 * citable here too - see AMP_UserData_Confinement_C.thy's own comments.
 *
 * Access and Refine/CRefine are sibling branches off AInvs (see
 * l4v/proof/ROOT), not a single heap lineage -- Isabelle cannot load two
 * heap images at once, so citing AMP_UserData (Access-based) from a theory
 * whose session sits on AMP_UserData_Refine_C (CRefine-based) forces this
 * session to re-elaborate the whole Access proof suite (Retype_AC,
 * Finalise_AC, Syscall_AC, ...) from source whenever its heap goes stale.
 * Measured 2026-08-04: ~4:45 elapsed / ~25:00 cpu time. This theory itself
 * unavoidably pays that cost, since composing across all three lineages is
 * exactly what it does. Its witnesses do not need to -- see
 * AMP_UserData_Confinement_C_Witnesses below for why they are a separate
 * session.
 *)
session AMP_UserData_Confinement_C in "userdata_confinement_c" = AMP_UserData_Refine_C +
  sessions
    AMP_UserData
    AMP_UserData_Refine
  theories
    "AMP_UserData_Confinement_C"

(*
 * Positive witness for AMP_UserData_Confinement_C's composed theorem, kept
 * out of that session so that adding or editing a witness (routine, and
 * only getting more frequent as "Checked initialization" work in PLAN.md
 * progresses) does not re-trigger the expensive Access re-elaboration
 * documented on AMP_UserData_Confinement_C above. This session only loads
 * that session's already-built heap.
 *)
session AMP_UserData_Confinement_C_Witnesses in "userdata_confinement_c_witnesses" = AMP_UserData_Confinement_C +
  theories
    "AMP_UserData_Confinement_C_Witnesses"

(*
 * The single place documenting AMP's headline, reader-facing results. Built
 * on AMP_UserData_Confinement_C (the richest UserData-case session) so its
 * REQ-ISO-2 entry can cite kernel_entry_user_mem_C_unauthorized_unchanged
 * directly. See CLAUDE.md's "Where things are" table.
 *)
session AMP_Overview in "overview" = AMP_UserData_Confinement_C +
  theories
    "AMP_Overview"

(*
 * Positive witnesses for AMP_Overview's headline results, kept out of that
 * session for the same reason as AMP_UserData_Confinement_C_Witnesses
 * above: witness churn should not force rebuilding anything upstream.
 * Cites AMP_UserData_Confinement_C_Witnesses directly (a sibling session
 * sharing the same AMP_UserData_Confinement_C parent, so merging it in is
 * cheap -- unlike the Access case above, there is no lineage mismatch here).
 *)
session AMP_Overview_Witnesses in "overview_witnesses" = AMP_Overview +
  sessions
    AMP_UserData_Confinement_C_Witnesses
  theories
    "AMP_Overview_Witnesses"
