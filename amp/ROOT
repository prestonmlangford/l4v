chapter "AMP"

(*
 * Sessions for the verified asymmetric-multiprocessing (AMP) work.
 * See ../../multicore-amp-plan.md for the phase plan; each phase adds one or a
 * few sessions here, each buildable green (no sorry) on its own.
 *
 * Fast iteration (see amp/README.md): every AMP session sits on top of an
 * already-built prerequisite whose heap is cached, so editing a phase's theory
 * rebuilds only that theory, not its dependencies.
 *)

(* Phase 1 -- AMP system model (spec only): the multicore composition of
   per-core abstract states. Builds on the cached ASpec heap. *)
session AMP_Model in "model" = ASpec +
  description \<open>Phase 1: AMP system model -- N single-core abstract states plus a static boot partition.\<close>
  theories
    "AMP_Model"

(* Phase 2 -- spatial partition invariant (B1-B3): each per-core kernel step
   preserves the partition. Builds on the cached AMP_Model heap. *)
session AMP_Spatial in "spatial" = AMP_Model +
  description \<open>Phase 2: spatial isolation -- a core's step touches only its owned frames; the writer/reader buffer mapping is asymmetric.\<close>
  theories
    "AMP_Spatial"

(* Phase 3 -- channel object + abstract operations (C1-C3): xchan_send and
   xchan_recv_ack, specified as atomic abstract steps mirroring IPC endpoints,
   shown to preserve the Phase 2 spatial partition invariant. Builds on the
   cached AMP_Spatial heap. *)
session AMP_Channel_A in "channel" = AMP_Spatial +
  description \<open>Phase 3: cross-core channel object -- xchan_send/xchan_recv_ack preserve the spatial partition invariant.\<close>
  theories
    "AMP_Channel_A"

(* Overview -- cumulative, machine-checked index of every phase's headline
   result: a plain-English paragraph directly beside the exact formal
   statement, re-derived from the real theorem so drift breaks the build. Read
   this file, not any phase's own theory, if you only want to know WHAT has
   been proved. Updated once per phase (plan section 2.5). Builds on the
   cached AMP_Channel_A heap (the latest phase), which imports all earlier
   phases transitively. *)
session AMP_Overview in "overview" = AMP_Channel_A +
  description \<open>Cumulative specification index: every phase's headline theorem, restated next to its plain-English meaning and re-derived from the real proof.\<close>
  theories
    "AMP_Overview"
